# Configurações opcionais para execução local.
#
# O projeto funciona com os valores padrão definidos no docker-compose.yml.
# Para personalizar a configuração:
#
#   cp .env.example .env
#
# O arquivo .env não deve ser versionado.

# Ambiente da aplicação.
APP_ENV=local

# Nome do serviço.
SERVICE_NAME=bootcamp-api

# Conexão utilizada quando o acesso ao PostgreSQL é feito diretamente
# pela máquina host.
DATABASE_URL=postgresql+psycopg2://bootcamp:bootcamp@localhost:5432/bootcamp

# Token exigido pelos endpoints internos.
# O cliente deve enviar:
#
# INTERNAL-TOKEN: default_token
INTERNAL_TOKEN=default_token

# Endereço utilizado pelos testes executados fora do Docker.
SERVER_LOCALHOST=0.0.0.0

# Portas opcionais.
# Descomente caso as portas padrão já estejam ocupadas.

# API_PORT=3001
# DB_PORT=5433